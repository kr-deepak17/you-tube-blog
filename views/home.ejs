<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('./partials/head') %>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Homepage</title>
</head>
<body>
    <%- include('./partials/nav') %>
        <div class="container mt-3 row row-cols-4">
            <% blogs.forEach(blog => { %>
                <div class="col">


                <section class="card col" style="max-width: 320px">
                <img src="<%= blog.coverImageURL %>" class="card-img-top">
                <div class="card-body">
                    <h4 class="card-title"> <%= blog.title %></h4>
                   
                    <a href="/blog/<%=blog._id  %>" class="btn-solid theme-primary">View</a>
                </div>
                </section>
                </div>
             
            <% }) %>


        </div>


    <%- include('./partials/scripts') %>
</body>
</html>